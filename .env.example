# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/protocolo_bim?schema=public"

# 32+ character secret used to sign session cookies (openssl rand -base64 32)
AUTH_SECRET="change-me-with-openssl-rand-base64-32-characters-long"

# Public base URL of the deployment. Read at run time, so a hosting panel can
# set it without rebuilding the image. Used for the OAuth redirect URI and for
# invitation links, both of which have to match exactly.
APP_URL="http://localhost:3000"

# --- Sign in with Google -----------------------------------------------------
# Google Cloud console → APIs & Services → Credentials → OAuth client ID (Web).
# Authorised redirect URI: <APP_URL>/api/auth/google/callback
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# --- Sign in with Microsoft --------------------------------------------------
# Entra ID → App registrations → New registration.
# Redirect URI (Web): <APP_URL>/api/auth/microsoft/callback
# MICROSOFT_CLIENT_ID=""
# MICROSOFT_CLIENT_SECRET=""
# Restrict sign-in to a single tenant by putting its id here; leave unset to
# accept any work, school or personal Microsoft account.
# MICROSOFT_TENANT_ID=""

# --- Transactional email (project invitations) -------------------------------
# Without either of these, invitations are still created and the interface
# offers the link to pass on by hand.
# MAIL_FROM="Protocolo BIM <no-reply@tu-dominio.com>"
# RESEND_API_KEY=""
# SMTP_URL="smtp://user:password@smtp.tu-dominio.com:587"

# Optional: use a Chromium already present on the host for PDF export
# CHROMIUM_EXECUTABLE_PATH="/opt/pw-browsers/chromium"
