# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/protocolo_bim?schema=public"

# 32+ character secret used to sign session cookies (openssl rand -base64 32)
AUTH_SECRET="change-me-with-openssl-rand-base64-32-characters-long"

# Public base URL, used for invitation links and PDF rendering
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: path to a preinstalled Chromium for PDF export
# PLAYWRIGHT_BROWSERS_PATH="/opt/pw-browsers"
